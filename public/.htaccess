<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Every store domain (store.appharu.com, *.store.appharu.com, custom domains) is served
    # by this one app; the app finds the store from the host name. Force https behind a proxy.
    RewriteCond %{HTTP:X-Forwarded-Proto} ^http$ [NC]
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1|[a-z0-9-]+\.localhost)(:\d+)?$ [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # Hidden files such as .env are never served
    RewriteRule (^|/)\.(?!well-known/) - [F,L]

    # Uploaded files are only ever served as pictures; anything else under /storage is refused.
    RewriteRule ^storage/(?!.+\.(?:jpe?g|png|gif|webp|avif|ico|svg)$) - [F,L,NC]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # A missing asset is answered here, without starting PHP
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^(css|js|vendor|storage)/ - [R=404,L]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# An SVG opened directly can never run script.
<IfModule mod_headers.c>
    <FilesMatch "\.svg$">
        Header set Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'"
    </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
