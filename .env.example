APP_NAME="Appharu Store"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://store.appharu.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

# The platform domain. Client stores get <slug>.store.appharu.com automatically
# (needs a wildcard DNS record and wildcard SSL); custom domains are added per store.
PLATFORM_DOMAIN=store.appharu.com
PLATFORM_NAME="Appharu MasterStore"
STOCK_RESERVATION_MINUTES=30
SUBSCRIPTION_GRACE_DAYS=7

BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=appharu_store
DB_USERNAME=appharu_store
DB_PASSWORD=

# Local demo data only (php artisan db:seed outside production).
DEMO_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

# database works out of the box; switch both to redis on the server when Redis is installed.
CACHE_STORE=database
QUEUE_CONNECTION=database
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@appharu.com"
MAIL_FROM_NAME="${APP_NAME}"
